# ============================================================
# AutoMind — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in values

# AI Provider: 'gemini' | 'openrouter' | 'auto' (auto-detects configured keys)
AI_PROVIDER="auto"

# Google Gemini API (Recommended: fast, native JSON schema support)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Optional aliases:
# GOOGLE_AI_API_KEY=""
# GOOGLE_API_KEY=""

# OpenRouter (Alternative provider)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_PRIMARY_MODEL="inclusionai/ring-2.6-1t:free"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/automind?sslmode=require"

# Auth.js
AUTH_SECRET="generate-a-random-secret-here"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Rate Limiting (Upstash Redis — optional)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Monitoring (optional)
# SENTRY_DSN=""
# NEXT_PUBLIC_POSTHOG_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
